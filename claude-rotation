#!/usr/bin/env bash
# The build accounts' rotation file, kept in an Azure Key Vault as the secret
# `claude-rotation`: the Claude accounts every build service and dev
# computer shares, each with a token from `claude setup-token`. tally picks
# among them by what each has left; the order only breaks ties. Run it from
# a computer signed in to Azure and, for pin and unpin, to the cluster tally
# runs in.
#
#   claude-rotation add EMAIL       mint a token for the account and add it last
#   claude-rotation order EMAIL...  the order that breaks ties
#   claude-rotation remove EMAIL    take the account out
#   claude-rotation pin EMAIL       use this account until it hits a limit
#   claude-rotation unpin           let tally pick again
#   claude-rotation list            the accounts, the active one, and the pin
#
# Settings come from the environment, or from
# ~/.config/tally/rotation.env (KEY=VALUE lines); the environment wins.
# CLAUDE_ROTATION_VAULT names the vault. CLAUDE_ROTATION_SUBSCRIPTION names
# its subscription, so a default `az` subscription in another tenant does not
# fail every read. CLAUDE_ROTATION_SECRET and CLAUDE_ROTATION_ACTIVE name the
# rotation's secret and the active account's. CLAUDE_ROTATION_NAMESPACE
# (default tally), CLAUDE_ROTATION_PIN (default claude-pin), and
# CLAUDE_ROTATION_CONTEXT (default the current one) say where tally's pin
# config map is. CLAUDE_ROTATION_AFTER is a command run once a pin has
# reached Key Vault, and after an unpin: one that puts this computer on the
# active account now, without waiting for its next sync.
set -euo pipefail

settings=${CLAUDE_ROTATION_SETTINGS:-${XDG_CONFIG_HOME:-$HOME/.config}/tally/rotation.env}
if [[ -f $settings ]]; then
	while IFS='=' read -r key value; do
		[[ $key =~ ^CLAUDE_ROTATION_[A-Z_]+$ ]] || continue
		[[ -n ${!key:-} ]] || export "$key=$value"
	done <"$settings"
fi

vault=${CLAUDE_ROTATION_VAULT:?set CLAUDE_ROTATION_VAULT to the Key Vault that holds the rotation}
secret=${CLAUDE_ROTATION_SECRET:-claude-rotation}
active_secret=${CLAUDE_ROTATION_ACTIVE:-claude-token-dev-active}
sub=()
if [[ -n ${CLAUDE_ROTATION_SUBSCRIPTION:-} ]]; then
	sub=(--subscription "$CLAUDE_ROTATION_SUBSCRIPTION")
fi
kube=(-n "${CLAUDE_ROTATION_NAMESPACE:-tally}")
if [[ -n ${CLAUDE_ROTATION_CONTEXT:-} ]]; then
	kube+=(--context "$CLAUDE_ROTATION_CONTEXT")
fi
pin_map=${CLAUDE_ROTATION_PIN:-claude-pin}

# The rotation as it stands. A rotation that does not exist yet is empty; any
# other failure stops the script, so it never writes over what it could not
# read.
current() {
	local n
	n=$(az keyvault secret list ${sub[@]+"${sub[@]}"} --vault-name "$vault" --query "length([?name=='$secret'])" -o tsv)
	if [[ $n == 1 ]]; then
		az keyvault secret show ${sub[@]+"${sub[@]}"} --vault-name "$vault" -n "$secret" --query value -o tsv
	else
		echo '[]'
	fi
}

save() {
	local value
	value=$(cat)
	jq -e 'type == "array"' >/dev/null <<<"$value"
	az keyvault secret set ${sub[@]+"${sub[@]}"} --vault-name "$vault" -n "$secret" --value "$value" \
		--description "Claude build accounts in rotation order, with their tokens; read by tally" -o none
}

# set_pin writes the account tally must use, or none. tally reads it within
# seconds and empties it itself when that account hits a limit.
set_pin() {
	kubectl "${kube[@]}" patch configmap "$pin_map" --type merge -p "$(jq -cn --arg a "$1" '{data: {account: $a}}')" >/dev/null
}

active_account() {
	az keyvault secret show ${sub[@]+"${sub[@]}"} --vault-name "$vault" -n "$active_secret" --query value -o tsv 2>/dev/null | jq -r '.account // empty' 2>/dev/null || true
}

pin_value() {
	kubectl "${kube[@]}" get configmap "$pin_map" -o jsonpath='{.data.account}'
}

# reach waits until Key Vault hands every consumer the account: tally reads
# the pin within seconds, and the cluster pushes its pick within a minute.
# It fails when tally lets go of the pin instead, because the account has no
# room left.
reach() {
	local deadline=$((SECONDS + 180))
	echo "Waiting for Key Vault to hand out $1..."
	while ((SECONDS < deadline)); do
		[[ $(active_account | tr '[:upper:]' '[:lower:]') == $(tr '[:upper:]' '[:lower:]' <<<"$1") ]] && return 0
		if [[ -z $(pin_value) ]]; then
			echo "tally let go of the pin: $1 has hit a limit" >&2
			return 1
		fi
		sleep 5
	done
	echo "Key Vault still does not hand out $1 after 3 minutes; is tally running?" >&2
	return 1
}

after() {
	[[ -z ${CLAUDE_ROTATION_AFTER:-} ]] || bash -c "$CLAUDE_ROTATION_AFTER"
}

list() {
	local rotation on pinned
	rotation=$(current)
	jq -r 'to_entries[] | "\(.key + 1). \(.value.account)"' <<<"$rotation"
	on=$(active_account)
	echo "active: ${on:-none yet}"
	if pinned=$(pin_value 2>/dev/null); then
		echo "pinned: ${pinned:-none}"
	else
		echo "pinned: unreadable (no access to the cluster)"
	fi
}

case "${1:-}" in
add)
	email=${2:?usage: claude-rotation add EMAIL}
	echo "A browser opens to sign in. Sign in as $email, then approve."
	echo "Claude Code prints a token that starts with sk-ant-oat01-."
	claude setup-token
	read -rsp "Paste that token: " token
	echo
	[[ $token == sk-ant-* ]] || { echo "that is not a Claude token" >&2; exit 1; }
	rotation=$(current)
	jq --arg a "$email" --arg t "$token" '[.[] | select(.account | ascii_downcase != ($a | ascii_downcase))] + [{account: $a, token: $t}]' <<<"$rotation" | save
	unset token
	list
	;;
order)
	shift
	[[ $# -gt 0 ]] || { echo "usage: claude-rotation order EMAIL..." >&2; exit 2; }
	want=$(printf '%s\n' "$@" | jq -R . | jq -s .)
	rotation=$(current)
	jq --argjson want "$want" '
		. as $all
		| if ($want | length) != ($all | length) then error("name every account in the rotation, once each") else . end
		| [$want[] as $w | $all[] | select(.account | ascii_downcase == ($w | ascii_downcase))]
		| if length != ($all | length) then error("an email is not in the rotation") else . end' <<<"$rotation" | save
	list
	;;
remove)
	email=${2:?usage: claude-rotation remove EMAIL}
	rotation=$(current)
	jq --arg a "$email" '[.[] | select(.account | ascii_downcase != ($a | ascii_downcase))]' <<<"$rotation" | save
	list
	;;
pin)
	email=${2:?usage: claude-rotation pin EMAIL}
	rotation=$(current)
	account=$(jq -r --arg a "$email" 'first(.[] | select(.account | ascii_downcase == ($a | ascii_downcase)) | .account) // empty' <<<"$rotation")
	[[ -n $account ]] || { echo "$email is not in the rotation" >&2; exit 1; }
	set_pin "$account"
	reach "$account"
	after
	echo "Pinned $account. tally lets go when it hits a limit."
	list
	;;
unpin)
	set_pin ""
	after
	echo "Unpinned. tally picks the account again."
	list
	;;
list)
	list
	;;
*)
	sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//'
	exit 2
	;;
esac
